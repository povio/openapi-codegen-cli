{
  "name": "@povio/openapi-codegen-cli",
  "keywords": [
    "codegen",
    "openapi",
    "povio",
    "react-query",
    "zod"
  ],
  "homepage": "https://github.com/povio/openapi-codegen-cli",
  "bugs": "https://github.com/povio/openapi-codegen-cli/issues",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/povio/openapi-codegen-cli.git"
  },
  "bin": {
    "openapi-codegen": "./dist/sh.mjs"
  },
  "files": [
    "README.md",
    "dist/*",
    "src/assets/**"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./metro": {
      "types": "./dist/metro.d.mts",
      "import": "./dist/metro.mjs",
      "require": "./dist/metro.cjs"
    },
    "./tiny": {
      "types": "./dist/tiny.d.mts",
      "import": "./dist/tiny.mjs"
    },
    "./generator": {
      "types": "./dist/generator.d.mts",
      "import": "./dist/generator.mjs"
    },
    "./acl": {
      "types": "./dist/acl.d.mts",
      "import": "./dist/acl.mjs"
    },
    "./zod": {
      "types": "./dist/zod.d.mts",
      "import": "./dist/zod.mjs"
    }
  },
  "scripts": {
    "start": "bun ./src/sh.ts",
    "test": "bun run build:native && bun run test:ts && bun run test:native",
    "test:ts": "OPENAPI_CODEGEN_NATIVE=0 vitest run",
    "test:native": "OPENAPI_CODEGEN_NATIVE=1 OPENAPI_CODEGEN_REQUIRE_FULL_NATIVE=1 vitest run",
    "test:watch": "vitest",
    "build": "tsdown && bun run build:native",
    "build:ts": "tsdown",
    "build:native": "bun ./scripts/build-native.mjs",
    "start:dist": "bun ./dist/sh.mjs",
    "gen:base": "rm -rf ./test/generated/base && mkdir -p ./test/generated/base && bun run start generate --config ./test/config.mjs --output ./test/generated/base --no-prettier",
    "gen:next": "rm -rf ./test/generated/next && mkdir -p ./test/generated/next && bun run start generate --config ./test/config.mjs --output ./test/generated/next --no-prettier",
    "test:generated-eq": "vitest run ./src/generators/generated-output-eq.test.ts",
    "gen:verify": "bun run gen:base && bun run gen:next && bun run test:generated-eq",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run test",
    "push": "bun ./scripts/publish.mjs",
    "dev:generate": "rm -rf ./output && bun run start generate --config ./test/config.mjs",
    "dev:check": "bun run start check --config ./test/config.mjs",
    "snapshot:openapi-localhost": "bun ./scripts/snapshot-openapi-localhost.mjs",
    "bench:vite-codegen": "bun ./scripts/benchmark-vite-codegen.mjs"
  },
  "dependencies": {
    "@orpc/contract": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "openapi-types": "^12.1.3",
    "prompt-sync": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@casl/ability": "6.8.0",
    "@casl/react": "5.0.1",
    "@tanstack/react-query": "~5.90.21",
    "@types/bun": "1.3.14",
    "@types/node": "^25.3.0",
    "@types/prompt-sync": "^4.2.3",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^5.1.4",
    "oxfmt": "^0.34.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "react": "^19.2.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.4",
    "typescript": "^7.0.2",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.0.18",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@casl/ability": "^6.7.3",
    "@casl/react": "^5.0.0",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.1",
    "i18next": "^25.8.11",
    "react": "^19.1.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "zod": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "@casl/ability": {
      "optional": true
    },
    "@casl/react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">= 1.3.14",
    "node": ">= 18"
  },
  "packageManager": "bun@1.3.14"
}
